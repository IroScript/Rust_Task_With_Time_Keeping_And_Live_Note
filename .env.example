# ============================================
# Local Development Configuration (SQLite)
# ============================================
# SQLite database - automatically created in backend/data folder
DATABASE_URL=sqlite:data/task_note.db

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# CORS (for frontend)
CORS_ORIGIN=http://localhost:5173

# Logging
RUST_LOG=info,backend=debug

# ============================================
# Cloud Configuration (PostgreSQL - Aiven)
# ============================================
# Uncomment below and comment SQLite DATABASE_URL when using cloud database
# DATABASE_URL=postgresql://avnadmin:your_password@your-host.aivencloud.com:10206/defaultdb?sslmode=require

# Individual PostgreSQL settings (optional, for reference)
# DATABASE_HOST=your-database-host.aivencloud.com
# DATABASE_PORT=10206
# DATABASE_NAME=defaultdb
# DATABASE_USER=avnadmin
# DATABASE_PASSWORD=your_database_password_here
# DATABASE_SSL_MODE=require
